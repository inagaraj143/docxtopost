{
    "name": "docxtopost/docxtopost-free",
    "description": "WordPress plugin to upload Word documents and convert to Posts. (Free version)",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.0",
        "83percent/mammoth": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AutoFormatPost\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
